// Workspace mode: one persistent sidebar, and a stack of agents beside it.
//
// The sidebar is a sibling of the stack, so it never moves and never reloads —
// picking an agent expands that agent's pane in place and collapses the others
// to title lines. This is the layout to use if you want the sidebar to stay put
// while the right-hand side changes.
//
// The tradeoff: panes belong to the session that owns them, so this only works
// for agents running in *this* session. Start them here. Agents in other
// sessions still show up in the sidebar; reaching those means jumping (Enter),
// which detaches and reattaches, or peeking (p), which does not.
//
// `solo true` means exactly one agent is on screen: picking another parks the
// current one off screen (Zellij calls it suppressed — it keeps running) and
// puts the new one in its place. No stack, so no leftover title lines.
//
// Open agents however you like; the first swap parks the extras.
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="vertical" {
        pane size=26 {
            plugin location="file:~/.config/zellij/plugins/agenttij.wasm" {
                // Only this session's agents, so Enter always stays in the
                // workspace and never detaches you out of it. Drop this to see
                // every agent on the machine, marked with ⇢.
                scope "session"
                solo "true"
            }
        }
        pane
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
